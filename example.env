# Example env file for local development. Copy to '.env' and update secrets before running.
# Do NOT commit your real .env with secrets to GitHub. This is for example only.

# Server
PORT=3000
LOG_LEVEL=info

# JWT secret used to sign auth tokens (set a strong random value in production)
JWT_SECRET=replace_this_with_a_strong_random_secret

# Postgres connection string
# Format: postgres://<user>:<password>@<host>:<port>/<database>
# Example for local Docker Compose:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rfq_dev

# Optional: path to SQLite fallback (not used when DATABASE_URL is set)
DB_PATH=./data.db
